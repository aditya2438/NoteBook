# =============================================================================
# NEXORA NOTES — ENVIRONMENT VARIABLES CONFIGURATION TEMPLATE
# Copy to .env.local or configure in Vercel / Cloud Run environment settings
# =============================================================================

# Gemini AI API Configuration (Required for AI Brain: Calculus solver & Mind map generation)
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# Application Base URL
APP_URL="http://localhost:3000"
NODE_ENV="development"

# Supabase Managed Database & Auth Configuration (Optional for cloud sync)
# Obtain from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# Real SMS Provider Configuration for Phone OTP (Optional - Simulated OTP is active by default)
# e.g., Twilio / AWS SNS
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Email Dispatcher for Password Reset & Verification (Optional)
# e.g., Resend / SendGrid / Postmark
RESEND_API_KEY=""
EMAIL_FROM="Nexora Notes <noreply@nexoranotes.com>"
